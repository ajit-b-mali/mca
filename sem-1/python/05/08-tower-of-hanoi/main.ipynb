      "start\n",
      "move 1 from a to c\n",
      "move 2 from a to b\n",
      "move 1 from c to b\n",
      "move 3 from a to c\n",
      "move 1 from b to a\n",
      "move 2 from b to c\n",
      "move 1 from a to c\n",
      "end\n"
     ]
    }
   ],
   "source": [
    "def tof(n, a, b, c):\n",
    "    if n < 1:\n",
    "        return\n",
    "    tof(n - 1, a, c, b)\n",
    "    print(f\"move {n} from {a} to {c}\")\n",
    "    tof(n - 1, b, a, c)\n",
    "    \n",
    "print(\"start\")\n",
    "tof(3, 'a', 'b', 'c')\n",
    "print(\"end\")"
   ]
  },
