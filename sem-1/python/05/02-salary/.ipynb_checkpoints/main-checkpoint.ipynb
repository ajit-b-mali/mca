   ],
   "source": [
    "basicSalary = int(input(\"Enter Basic Salary: \"))\n",
    "\n",
    "hra = basicSalary * 10 / 100\n",
    "ta = basicSalary * 5 / 100\n",
    "grossSalary = basicSalary + hra + ta\n",
    "pt = grossSalary * 2 / 100\n",
    "netSalary = grossSalary - pt\n",
    "\n",
    "print(\"Net Salary: \", netSalary)"
   ]
